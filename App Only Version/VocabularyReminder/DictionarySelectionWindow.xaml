<Window x:Class="VR.DictionarySelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Select Dictionary"
        Width="450"
        Height="600"
        MinWidth="400"
        MinHeight="400"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">
    
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                    <Setter Property="BorderBrush" Value="#666666"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#106EBE"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE"/>
                    <Setter Property="BorderBrush" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D13438"/>
            <Setter Property="BorderBrush" Value="#A1292D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A1292D"/>
                    <Setter Property="BorderBrush" Value="#7A1E22"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#7A1E22"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="BorderBrush" Value="#555555"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0078D4"/>
                    <Setter Property="BorderBrush" Value="#106EBE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Label x:Name="Label_Title" 
                   Content="Select Target Dictionary" 
                   FontSize="18" 
                   FontWeight="Bold"
                   Foreground="#FFFFFF"/>
            <TextBlock x:Name="TextBlock_Subtitle" 
                       Text="Choose a dictionary to move the vocabulary to:" 
                       Foreground="#CCCCCC"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Current Information -->
        <Border Grid.Row="1" 
                Background="#2D2D2D" 
                BorderBrush="#555555" 
                BorderThickness="1" 
                CornerRadius="4" 
                Padding="12"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="CURRENT INFORMATION" 
                           FontSize="10" 
                           FontWeight="Bold" 
                           Foreground="#888888" 
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Word: " Foreground="#CCCCCC"/>
                    <TextBlock x:Name="TextBlock_WordName" 
                               Text="[Word]" 
                               FontWeight="Bold" 
                               Foreground="#FFFFFF"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Current Dictionary: " Foreground="#CCCCCC"/>
                    <TextBlock x:Name="TextBlock_CurrentDictionary" 
                               Text="[Current Dictionary]" 
                               FontWeight="Bold" 
                               Foreground="#FFD700"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Instruction -->
        <TextBlock Grid.Row="2" 
                   Text="Available target dictionaries:" 
                   FontWeight="Bold" 
                   Margin="0,0,0,10"
                   Foreground="#FFFFFF"/>

        <!-- Dictionary List -->
        <Border Grid.Row="3" 
                BorderBrush="#555555" 
                BorderThickness="1" 
                CornerRadius="4"
                Background="#2D2D2D">
            <ListBox x:Name="ListBox_Dictionaries"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionMode="Single"
                     Margin="8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="📁" 
                                       FontSize="16" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,8,0"/>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" 
                                           FontWeight="Bold" 
                                           FontSize="14"/>
                                <TextBlock Text="{Binding Description, TargetNullValue='No description'}" 
                                           FontSize="11" 
                                           Foreground="#AAAAAA" 
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            
                            <TextBlock Grid.Column="2" 
                                       Text="{Binding Id, StringFormat='ID: {0}'}" 
                                       FontSize="10" 
                                       Foreground="#888888" 
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button x:Name="Btn_Cancel" 
                    Content="Cancel" 
                    Style="{StaticResource CancelButton}"
                    Width="80" 
                    Margin="0,0,10,0"
                    Click="Btn_Cancel_Click"/>
            <Button x:Name="Btn_Move" 
                    Content="Move" 
                    Style="{StaticResource PrimaryButton}"
                    Width="80"
                    Click="Btn_Move_Click"/>
        </StackPanel>
    </Grid>
</Window>