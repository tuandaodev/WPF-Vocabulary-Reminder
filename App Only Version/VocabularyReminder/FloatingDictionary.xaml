<Window x:Class="VR.FloatingDictionary"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VR"
        mc:Ignorable="d"
        Title="Floating Dictionary"
        Width="400"
        Height="400"
        MinWidth="350"
        MinHeight="250"
        Background="#1E1E1E"
        WindowStyle="None"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        BorderBrush="#333333"
        BorderThickness="1"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Focusable="True">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>
    
    <Border Background="#1E1E1E" MouseDown="Border_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="#2D2D2D" Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Floating Dictionary" 
                          Grid.Column="0"
                          VerticalAlignment="Center"
                          Margin="10,0"
                          FontWeight="Bold"
                          FontSize="12"/>
                
                <!-- Pin/Unpin Button -->
                <Button x:Name="Btn_Pin"
                        Grid.Column="1"
                        Content="📌"
                        Width="30"
                        Height="30"
                        ToolTip="Pin/Unpin window"
                        Click="Btn_Pin_Click"
                        Background="Transparent"
                        Margin="0"/>
                
                <!-- Settings Button -->
                <Button x:Name="Btn_Settings"
                        Grid.Column="2"
                        Content="⚙"
                        Width="30"
                        Height="30"
                        ToolTip="Settings"
                        Click="Btn_Settings_Click"
                        Background="Transparent"
                        Margin="0"/>
                
                <!-- Close Button -->
                <Button x:Name="Btn_Close"
                        Grid.Column="3"
                        Content="✕"
                        Width="30"
                        Height="30"
                        ToolTip="Close"
                        Click="Btn_Close_Click"
                        Background="Transparent"
                        Margin="0"/>
            </Grid>

            <!-- Tab Control -->
            <TabControl x:Name="MainTabControl" Grid.Row="1" Grid.RowSpan="2" Margin="10" Background="#1E1E1E" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#2D2D2D"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="Margin" Value="0,0,2,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderThickness="0"
                                            CornerRadius="4,4,0,0">
                                        <ContentPresenter x:Name="ContentSite"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        ContentSource="Header"
                                                        Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#444444"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3D3D3D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- Dictionary Tab -->
                <TabItem Header="📖 Dictionary" x:Name="Tab_Dictionary">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Input Section -->
                        <Grid Grid.Row="0" Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="Txt_Input"
                                     Grid.Column="0"
                                     Height="25"
                                     VerticalAlignment="Center"
                                     KeyDown="Txt_Input_KeyDown"
                                     Text="Type word here or select text from any application..."/>
                            
                            <Button x:Name="Btn_Lookup"
                                    Grid.Column="1"
                                    Content="🔍"
                                    Width="30"
                                    Height="25"
                                    ToolTip="Lookup word"
                                    Click="Btn_Lookup_Click"
                                    Margin="5,0,0,0"/>
                        </Grid>

                        <!-- Results Section -->
                        <ScrollViewer Grid.Row="1"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="Panel_Results">
                                <!-- Word and Basic Info -->
                                <StackPanel x:Name="Panel_WordInfo" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock x:Name="Lbl_Word"
                                                  FontSize="20"
                                                  FontWeight="Bold"
                                                  Margin="0,0,10,0"/>
                                        <TextBlock x:Name="Lbl_Type"
                                                  FontSize="14"
                                                  FontStyle="Italic"
                                                  Foreground="#999999"
                                                  VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    
                                    <!-- IPA -->
                                    <TextBlock x:Name="Lbl_IPA"
                                              FontSize="14"
                                              Foreground="#CCCCCC"
                                              Margin="0,0,0,10"/>
                                </StackPanel>

                                <!-- Translation -->
                                <StackPanel x:Name="Panel_Translation" Visibility="Collapsed">
                                    <TextBlock Text="Translation:"
                                              FontWeight="Bold"
                                              FontSize="12"
                                              Foreground="#999999"
                                              Margin="0,0,0,2"/>
                                    <TextBlock x:Name="Lbl_Translation"
                                              FontSize="14"
                                              Margin="0,0,0,10"/>
                                </StackPanel>

                                <!-- Definition -->
                                <StackPanel x:Name="Panel_Definition" Visibility="Collapsed">
                                    <TextBlock Text="Definition:"
                                              FontWeight="Bold"
                                              FontSize="12"
                                              Foreground="#999999"
                                              Margin="0,0,0,2"/>
                                    <TextBlock x:Name="Lbl_Definition"
                                              FontSize="14"
                                              Margin="0,0,0,10"/>
                                </StackPanel>

                                <!-- Example -->
                                <StackPanel x:Name="Panel_Example" Visibility="Collapsed">
                                    <TextBlock Text="Example:"
                                              FontWeight="Bold"
                                              FontSize="12"
                                              Foreground="#999999"
                                              Margin="0,0,0,2"/>
                                    <TextBlock x:Name="Lbl_Example"
                                              FontSize="14"
                                              Margin="0,0,0,10"/>
                                </StackPanel>

                                <!-- Loading Indicator -->
                                <StackPanel x:Name="Panel_Loading"
                                           Orientation="Horizontal"
                                           HorizontalAlignment="Center"
                                           Visibility="Collapsed"
                                           Margin="0,20">
                                    <TextBlock Text="Looking up..."
                                              FontStyle="Italic"
                                              Foreground="#999999"/>
                                </StackPanel>

                                <!-- No Results -->
                                <StackPanel x:Name="Panel_NoResults"
                                           HorizontalAlignment="Center"
                                           Visibility="Collapsed"
                                           Margin="0,20">
                                    <TextBlock Text="No results found"
                                              FontStyle="Italic"
                                              Foreground="#999999"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Dictionary Action Buttons -->
                        <StackPanel Grid.Row="2"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   Margin="0,10">
                            <Button x:Name="Btn_AddToDict"
                                    Content="Add to Dictionary"
                                    Click="Btn_AddToDict_Click"
                                    Visibility="Collapsed"/>
                            
                            <Button x:Name="Btn_OpenFull"
                                    Content="Open Full View"
                                    Click="Btn_OpenFull_Click"
                                    Visibility="Collapsed"
                                    Margin="5,0,0,0"/>
                            
                            <Button x:Name="Btn_Speak"
                                    Content="🔊"
                                    Width="35"
                                    ToolTip="Speak word"
                                    Click="Btn_Speak_Click"
                                    Visibility="Collapsed"
                                    Margin="5,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Grammar Check Tab -->
                <TabItem Header="✍️ Grammar" x:Name="Tab_Grammar">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Input Section for Grammar -->
                        <Grid Grid.Row="0" Margin="0,10,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="Enter text to check grammar:"
                                      Grid.Row="0"
                                      FontWeight="Bold"
                                      FontSize="12"
                                      Foreground="#CCCCCC"
                                      Margin="0,0,0,5"/>
                            
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox x:Name="Txt_GrammarInput"
                                         Grid.Column="0"
                                         Height="60"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalAlignment="Stretch"
                                         KeyDown="Txt_GrammarInput_KeyDown"
                                         Text="Type or paste your text here for grammar checking..."/>
                                
                                <Button x:Name="Btn_CheckGrammar"
                                        Grid.Column="1"
                                        Content="✅"
                                        Width="30"
                                        Height="30"
                                        ToolTip="Check grammar"
                                        Click="Btn_CheckGrammar_Click"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Top"/>
                            </Grid>
                        </Grid>

                        <!-- Grammar Results Section -->
                        <ScrollViewer Grid.Row="1"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="Panel_GrammarResults">
                                <!-- Corrected Text -->
                                <StackPanel x:Name="Panel_CorrectedText" Visibility="Collapsed">
                                    <TextBlock Text="Corrected Text:"
                                              FontWeight="Bold"
                                              FontSize="12"
                                              Foreground="#4CAF50"
                                              Margin="0,0,0,5"/>
                                    <Border Background="#1B2F1B"
                                           BorderBrush="#4CAF50"
                                           BorderThickness="1"
                                           CornerRadius="4"
                                           Padding="8"
                                           Margin="0,0,0,10">
                                        <TextBlock x:Name="Lbl_CorrectedText"
                                                  FontSize="14"
                                                  TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <!-- Grammar Suggestions -->
                                <StackPanel x:Name="Panel_GrammarSuggestions" Visibility="Collapsed">
                                    <TextBlock Text="Grammar Analysis:"
                                              FontWeight="Bold"
                                              FontSize="12"
                                              Foreground="#2196F3"
                                              Margin="0,0,0,5"/>
                                    <Border Background="#1B2A3F"
                                           BorderBrush="#2196F3"
                                           BorderThickness="1"
                                           CornerRadius="4"
                                           Padding="8"
                                           Margin="0,0,0,10">
                                        <TextBlock x:Name="Lbl_GrammarSuggestions"
                                                  FontSize="14"
                                                  TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <!-- Grammar Loading Indicator -->
                                <StackPanel x:Name="Panel_GrammarLoading"
                                           Orientation="Horizontal"
                                           HorizontalAlignment="Center"
                                           Visibility="Collapsed"
                                           Margin="0,20">
                                    <TextBlock Text="Checking grammar..."
                                              FontStyle="Italic"
                                              Foreground="#999999"/>
                                </StackPanel>

                                <!-- Grammar No Results -->
                                <StackPanel x:Name="Panel_GrammarNoResults"
                                           HorizontalAlignment="Center"
                                           Visibility="Collapsed"
                                           Margin="0,20">
                                    <TextBlock Text="No grammar issues found!"
                                              FontStyle="Italic"
                                              Foreground="#4CAF50"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Grammar Action Buttons -->
                        <StackPanel Grid.Row="2"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   Margin="0,10">
                            <Button x:Name="Btn_CopyOriginal"
                                    Content="📋 Copy Original"
                                    Click="Btn_CopyOriginal_Click"
                                    Visibility="Collapsed"/>
                            
                            <Button x:Name="Btn_CopyCorrected"
                                    Content="📋 Copy Corrected"
                                    Click="Btn_CopyCorrected_Click"
                                    Visibility="Collapsed"
                                    Margin="5,0,0,0"/>
                            
                            <Button x:Name="Btn_ClearGrammar"
                                    Content="🗑️ Clear"
                                    Click="Btn_ClearGrammar_Click"
                                    Visibility="Collapsed"
                                    Margin="5,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

        </Grid>
    </Border>
</Window>