<Window x:Class="VR.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Spaced Repetition Statistics"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="ChartLine" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Spaced Repetition Progress" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <ComboBox x:Name="DictionaryComboBox" 
                      Width="200" 
                      Margin="20,0,0,0"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectionChanged="DictionaryComboBox_SelectionChanged"/>
            <Button x:Name="RefreshButton" 
                    Content="Refresh" 
                    Click="RefreshButton_Click" 
                    Margin="10,0,0,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>

        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Words Card -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,10,0" Padding="15">
                <StackPanel>
                    <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="24" Height="24" HorizontalAlignment="Center" Foreground="DarkBlue"/>
                    <TextBlock x:Name="TotalWordsText" Text="0" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="Total Words" FontSize="12" HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- New Words Card -->
            <materialDesign:Card Grid.Column="1" Margin="5,0,5,0" Padding="15">
                <StackPanel>
                    <materialDesign:PackIcon Kind="NewBox" Width="24" Height="24" HorizontalAlignment="Center" Foreground="Blue"/>
                    <TextBlock x:Name="NewWordsText" Text="0" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="New Words" FontSize="12" HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Learning Words Card -->
            <materialDesign:Card Grid.Column="2" Margin="5,0,5,0" Padding="15">
                <StackPanel>
                    <materialDesign:PackIcon Kind="School" Width="24" Height="24" HorizontalAlignment="Center" Foreground="Orange"/>
                    <TextBlock x:Name="LearningWordsText" Text="0" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="Learning" FontSize="12" HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Due Words Card -->
            <materialDesign:Card Grid.Column="3" Margin="5,0,5,0" Padding="15">
                <StackPanel>
                    <materialDesign:PackIcon Kind="ClockAlert" Width="24" Height="24" HorizontalAlignment="Center" Foreground="Red"/>
                    <TextBlock x:Name="DueWordsText" Text="0" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="Due Today" FontSize="12" HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Learned Words Card -->
            <materialDesign:Card Grid.Column="4" Margin="10,0,0,0" Padding="15">
                <StackPanel>
                    <materialDesign:PackIcon Kind="CheckCircle" Width="24" Height="24" HorizontalAlignment="Center" Foreground="Green"/>
                    <TextBlock x:Name="LearnedWordsText" Text="0" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="Learned" FontSize="12" HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- Charts Section -->
        <TabControl Grid.Row="2" materialDesign:ColorZoneAssist.Mode="PrimaryMid">
            
            <!-- Overview Tab -->
            <TabItem Header="Overview">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Statistics Summary -->
                    <materialDesign:Card Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,15" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Average Ease Factor" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock x:Name="AverageEaseFactorText" Text="2.50" FontSize="20"/>
                                <TextBlock Text="Total Reviews" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBlock x:Name="TotalReviewsText" Text="0" FontSize="20"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total Lapses" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock x:Name="TotalLapsesText" Text="0" FontSize="20"/>
                                <TextBlock Text="Success Rate" FontWeight="Bold" Margin="0,15,0,5"/>
                                <TextBlock x:Name="SuccessRateText" Text="0%" FontSize="20"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Retention Rate" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock x:Name="RetentionRateText" Text="0%" FontSize="20"/>
                                <TextBlock Text="Learning Progress" FontWeight="Bold" Margin="0,15,0,5"/>
                                <ProgressBar x:Name="LearningProgressBar" Height="20" Value="0" Maximum="100"/>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Interval Distribution Chart -->
                    <materialDesign:Card Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Interval Distribution" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                            <Canvas x:Name="IntervalChart" Height="300" Background="White"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Ease Factor Distribution Chart -->
                    <materialDesign:Card Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Ease Factor Distribution" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                            <Canvas x:Name="EaseFactorChart" Height="300" Background="White"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- Progress History Tab -->
            <TabItem Header="Progress History">
                <materialDesign:Card Margin="10" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Review Activity (Last 30 Days)" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                        <Canvas x:Name="ProgressChart" Height="400" Background="White"/>
                    </StackPanel>
                </materialDesign:Card>
            </TabItem>

            <!-- Detailed Stats Tab -->
            <TabItem Header="Detailed Statistics">
                <ScrollViewer Margin="10">
                    <StackPanel>
                        <!-- Interval Distribution List -->
                        <materialDesign:Card Margin="0,0,0,15" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Interval Distribution Details" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                <DataGrid x:Name="IntervalDistributionGrid" 
                                          AutoGenerateColumns="False" 
                                          IsReadOnly="True"
                                          CanUserSortColumns="False"
                                          Height="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Interval Range" Binding="{Binding IntervalRange}" Width="*"/>
                                        <DataGridTextColumn Header="Word Count" Binding="{Binding WordCount}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Ease Factor Distribution List -->
                        <materialDesign:Card Padding="15">
                            <StackPanel>
                                <TextBlock Text="Ease Factor Distribution Details" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                <DataGrid x:Name="EaseFactorDistributionGrid" 
                                          AutoGenerateColumns="False" 
                                          IsReadOnly="True"
                                          CanUserSortColumns="False"
                                          Height="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ease Factor Range" Binding="{Binding EaseRange}" Width="*"/>
                                        <DataGridTextColumn Header="Word Count" Binding="{Binding WordCount}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>