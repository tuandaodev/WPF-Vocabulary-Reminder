<Window x:Class="VR.VocaPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VR"
        mc:Ignorable="d"
        Title="VocaPopup"
        Width="600"
        MinHeight="400"
        MaxHeight="1000"
        SizeToContent="Height"
        Background="#1E1E1E"
        WindowStyle="None"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        BorderBrush="#333333"
        BorderThickness="1"
        Focusable="True"
        KeyboardNavigation.TabNavigation="None"
        FocusManager.FocusedElement="{Binding ElementName=Btn_Good}">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Border Padding="20" Background="#1E1E1E" MouseEnter="Border_MouseEnter" MouseLeave="Border_MouseLeave" MouseDown="Border_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

           <!-- Close Button -->
           <Button x:Name="CloseButton"
                   Grid.Row="0"
                        Content="✕"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="24"
                        Height="24"
                        Margin="0,-12,-12,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#666666"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#333333"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            
            <ScrollViewer Grid.Row="1"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Margin="0,5,0,0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="#1E1E1E"/>
                        <Setter Property="Foreground" Value="#333333"/>
                    </Style>
                </ScrollViewer.Resources>
                
                <StackPanel>
            <!-- Header -->
            <DockPanel Margin="0,0,0,10" x:Name="SectionWord">
                <!-- Left Group: Word + IPA -->
                <StackPanel DockPanel.Dock="Left">
                    <!-- Word and Type -->
                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="Label_Word"
                                Content="Word"
                                FontSize="32"
                                FontWeight="Bold"
                                Padding="0"
                                Margin="0"/>
                        <TextBlock x:Name="Label_Type"
                                Text="Type"
                                FontSize="16"
                                FontStyle="Italic"
                                Margin="12,12,0,0"
                                VerticalAlignment="Top"
                                Foreground="#999999"/>
                        <Label x:Name="Label_Level"
                                Content=""
                                FontSize="16"
                                FontWeight="Bold"
                                Padding="0"
                                Margin="12,12,0,0"
                                VerticalAlignment="Top"
                                Visibility="Collapsed"/>
                    </StackPanel>
                    
                    <!-- IPA Section -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <StackPanel>
                            <Label Content="IPA US"
                                   FontSize="10"
                                   Padding="0"
                                   Foreground="#fff"/>
                            <Label x:Name="Label_IPA"
                                   Content="IPA"
                                   FontSize="18"
                                   Padding="0"
                                   Margin="0,0,24,0"/>
                        </StackPanel>
                        <StackPanel>
                            <Label Content="IPA UK"
                                   FontSize="10"
                                   Padding="0"
                                   Foreground="#fff"/>
                            <Label x:Name="Label_IPA2"
                                   Content="IPA 2"
                                   FontSize="18"
                                   Padding="0"
                                   Margin="0,0,24,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                
                <!-- Right Group: Dictionary Buttons -->
                <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- First Row of Buttons -->
                    <Button x:Name="Btn_OpenCambridge"
                            Grid.Row="0" Grid.Column="0"
                            Content="🔍 C"
                            ToolTip="Open in Cambridge Dictionary"
                            Width="60"
                            MinWidth="60"
                            Height="36"
                            Margin="0,0,4,4"
                            Click="Btn_OpenCambridge_Click"/>
                    <Button x:Name="Btn_OpenOxford"
                            Grid.Row="0" Grid.Column="1"
                            Content="🔍 O"
                            ToolTip="Open in Oxford Dictionary"
                            Width="60"
                            MinWidth="60"
                            Height="36"
                            Margin="4,0,0,4"
                            Click="Btn_OpenOxford_Click"/>
                    
                    <!-- Second Row of Buttons -->
                    <Button x:Name="Btn_OpenGTranslate"
                            Grid.Row="1" Grid.Column="0"
                            Content="🔍 G"
                            ToolTip="Open in Google Translate"
                            Width="60"
                            MinWidth="60"
                            Height="36"
                            Margin="0,0,4,0"
                            Click="Btn_OpenGTranslate_Click"/>
                    <Button x:Name="Btn_OpenYouGlish"
                            Grid.Row="1" Grid.Column="1"
                            Content="🔍 Y"
                            ToolTip="Open in YouGlish"
                            Width="60"
                            MinWidth="60"
                            Height="36"
                            Margin="4,0,0,0"
                            Click="Btn_OpenYouGlish_Click"/>
                </Grid>
            </DockPanel>

            <!-- Translations -->
            <TextBlock Text="TRANSLATIONS" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="Label_Translate1"
                       Text="Vietnamese translation"
                       TextWrapping="Wrap"
                       Foreground="#FFFFFF"
                       FontSize="18"
                       Margin="0,4,0,8"/>
            
            <!-- Definition Section -->
            <DockPanel LastChildFill="True" Margin="0,0,0,12" x:Name="SectionDef" VerticalAlignment="Center">
                <!-- Definition Header -->
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                         <TextBlock x:Name="Label_DefType" Text="Type" Margin="0,0,8,0" FontSize="16" Foreground="#fff400" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Label_DefLevel"
                            Text="Level"
                            FontSize="16"
                            FontStyle="Italic"
                            Margin="0,0,8,0"
                            Foreground="#94f1ff"
                            Visibility="Collapsed"/>
                        <TextBlock x:Name="Label_DefPartOfSpeech"
                            Text="PartOfSpeech"
                            FontSize="14"
                            FontStyle="Italic"
                            Foreground="#999999"
                            Margin="0,0,16,0"
                            Visibility="Collapsed"/>
                        <TextBlock x:Name="Label_DefTopic"
                            Text="Topic"
                            FontSize="17"
                            Foreground="#FFFFFF"
                            Margin="0,0,16,0"
                            Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right"
                               Orientation="Horizontal"
                               VerticalAlignment="Top"
                               Margin="0,-4,0,0">
                        <Button x:Name="Btn_PrevDefinition"
                                 Content="◀"
                                 Width="40"
                                 MinWidth="40"
                                 Height="20"
                                 Margin="0,0,4,0"
                                 Click="Btn_PrevDefinition_Click"/>
                        <TextBlock x:Name="Label_DefinitionIndex"
                                   Text="1/1"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"
                                   Margin="8,0"/>
                        <Button x:Name="Btn_NextDefinition"
                                 Content="▶"
                                 Width="40"
                                 MinWidth="40"
                                 Height="20"
                                 Margin="4,0,0,0"
                                 Click="Btn_NextDefinition_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- Definition and Example Content -->
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="Btn_TranslateDefinition"
                                DockPanel.Dock="Right"
                                Width="24"
                                Height="24"
                                Margin="8,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="Translate definition to Vietnamese using LLM"
                                Click="Btn_TranslateDefinition_Click"
                                VerticalAlignment="Top"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="2">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#55FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="TranslateIcon" Fill="#FFFFFF" Data="M12.87,15.07L10.33,12.56L10.36,12.53C12.1,10.59 13.34,8.36 14.07,6H17V4H10V2H8V4H1V6H12.17C11.5,7.92 10.44,9.75 9,11.35C8.07,10.32 7.3,9.19 6.69,8H4.69C5.42,9.63 6.42,11.17 7.67,12.56L2.58,17.58L4,19L9,14L12.11,17.11L12.87,15.07M18.5,10H16.5L12,22H14L15.12,19H19.87L21,22H23L18.5,10M15.88,17L17.5,12.67L19.12,17H15.88Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <TextBlock x:Name="Label_EngDefination"
                                 Text=""
                                 TextWrapping="Wrap"
                                 Foreground="#FFFFFF"
                                 FontSize="18"
                                 Margin="0,4,0,12"/>
                    </DockPanel>
                    
                    <!-- Vietnamese Translation of Definition -->
                    <TextBlock x:Name="Label_VietnameseDefinition"
                             Text=""
                             TextWrapping="Wrap"
                             Foreground="#88FFFFFF"
                             FontStyle="Italic"
                             FontSize="16"
                             Margin="0,0,0,12"
                             Visibility="Collapsed"/>
                    
                    <!-- Example Section with Navigation -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,0">
                        <!-- Example Header with Navigation -->
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8" VerticalAlignment="Center">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="EXAMPLE" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="Label_ExampleStruct"
                                         Text=""
                                         Foreground="#FFB366"
                                         FontStyle="Italic"
                                         FontSize="14"
                                         Margin="8,0,0,0"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right"
                                       Orientation="Horizontal"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,0">
                                <Button x:Name="Btn_PrevExample"
                                         Content="◀"
                                         Width="40"
                                         MinWidth="40"
                                         Height="20"
                                         Margin="0,0,4,0"
                                         Click="Btn_PrevExample_Click"/>
                                <TextBlock x:Name="Label_ExampleIndex"
                                           Text="1/1"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           Margin="8,0"/>
                                <Button x:Name="Btn_NextExample"
                                         Content="▶"
                                         Width="40"
                                         MinWidth="40"
                                         Height="20"
                                         Margin="4,0,0,0"
                                         Click="Btn_NextExample_Click"/>
                            </StackPanel>
                        </DockPanel>
                        
                        <!-- Example Content -->
                        <TextBlock x:Name="Label_Example"
                                 Text=""
                                 TextWrapping="Wrap"
                                 Foreground="#FFFFFF"
                                 FontSize="16"
                                 Margin="0,4,0,4"/>
                    </DockPanel>
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="Label_ExampleTranslation"
                       Text=""
                       TextWrapping="Wrap"
                       Foreground="#88FFFFFF"
                       FontStyle="Italic"
                       FontSize="16"
                       Margin="0,4,0,4"
                       Visibility="Collapsed"/>
            
            <TextBlock x:Name="Label_ExamplePhonetic"
                       Text=""
                       TextWrapping="Wrap"
                       Foreground="#FFFFFF"
                       FontStyle="Italic"
                       FontSize="18"
                       Margin="0,0,0,12"
                       Visibility="Collapsed"/>
            
            <StackPanel Margin="0,0,0,12">
                <!-- First row: 5 buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="Btn_ReadExample"
                            Content="Read"
                            HorizontalAlignment="Left"
                            Width="90"
                            ToolTip="Read and Translate Example from Google Translate"
                            Click="Btn_ReadExample_Click"/>
                    <Button x:Name="Btn_TranslateExample"
                            Content="Translate AI"
                            HorizontalAlignment="Left"
                            Width="90"
                            Margin="6,0,0,0"
                            ToolTip="Translate Example to Vietnamese using LLM"
                            Click="Btn_TranslateExample_Click"/>
                    <Button x:Name="Btn_GetExamplePhonetics"
                              Content="Phonetics"
                              HorizontalAlignment="Left"
                              Width="90"
                              Margin="6,0,0,0"
                              Click="Btn_GetExamplePhonetics_Click"/>
                    <Button x:Name="Btn_GenerateExample"
                            Content="New Example AI"
                            HorizontalAlignment="Left"
                            Width="90"
                            Margin="6,0,0,0"
                            ToolTip="Generate a new example sentence using AI"
                            Click="Btn_GenerateExample_Click"/>
                    <Button x:Name="Btn_GetEasySynonyms"
                            Content="Synonyms"
                            HorizontalAlignment="Left"
                            Width="90"
                            Margin="6,0,0,0"
                            ToolTip="Find easier synonyms to learn first"
                            Click="Btn_GetEasySynonyms_Click"/>
                </StackPanel>
                
                <!-- Second row: 2 buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <Button x:Name="Btn_GenerateSimpleSentence"
                            Content="Simple AI"
                            HorizontalAlignment="Left"
                            Width="90"
                            ToolTip="Generate a short, easy-to-understand sentence"
                            Click="Btn_GenerateSimpleSentence_Click"/>
                    <Button x:Name="Btn_ExplainUsage"
                            Content="Usage Tips AI"
                            HorizontalAlignment="Left"
                            Width="90"
                            Margin="6,0,0,0"
                            ToolTip="Get detailed usage explanation and tips"
                            Click="Btn_ExplainUsage_Click"/>
                </StackPanel>
            </StackPanel>


            <!-- Related Words -->
            <StackPanel x:Name="SectionRelatedWords">
                <TextBlock Text="RELATED WORDS" Style="{StaticResource SectionTitle}"/>
                <WrapPanel x:Name="RelatedWordsContainer" Margin="0,4,0,20">
                    <!-- Dynamic clickable words will be added here -->
                </WrapPanel>
            </StackPanel>

            <!-- SRS Information -->
            <!--<TextBlock Text="REVIEW INFORMATION" Style="{StaticResource SectionTitle}"/>-->
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0"
                          Text="Next Review: "
                          Foreground="#666666"/>
                <TextBlock x:Name="Label_NextReview"
                          Grid.Row="0" Grid.Column="1"
                          Text="Not scheduled"
                          Foreground="#FFFFFF"/>
                
                <TextBlock Grid.Row="1" Grid.Column="0"
                          Text="Current Interval: "
                          Foreground="#666666"/>
                <TextBlock x:Name="Label_Interval"
                          Grid.Row="1" Grid.Column="1"
                          Text="New"
                          Foreground="#FFFFFF"/>
            </Grid>

            <!-- Rating Buttons -->
            <UniformGrid Rows="1" Margin="0,0,0,20">
                <Button x:Name="Btn_Again"
                        Content="Again (1)"
                        Background="#E57373"
                        Margin="0,0,5,0"
                        Click="Btn_Again_Click"/>
                <Button x:Name="Btn_Hard"
                        Content="Hard (2)"
                        Background="#FFB74D"
                        Margin="5,0"
                        Click="Btn_Hard_Click"/>
                <Button x:Name="Btn_Good"
                        Content="Good (3)"
                        Background="#81C784"
                        Margin="5,0"
                        Click="Btn_Good_Click"/>
                <Button x:Name="Btn_Easy"
                        Content="Easy (4)"
                        Background="#64B5F6"
                        Margin="5,0,0,0"
                        Click="Btn_Easy_Click"/>
            </UniformGrid>

            <!-- Control Buttons -->
            <UniformGrid Rows="1" Margin="0,0,0,0">
                <Button x:Name="Btn_PlaySound1"
                        ToolTip="Play Sound US (F8)"
                        Content="▶"
                        Margin="0,0,5,0"
                        FontSize="14"
                        Click="Btn_PlaySound1_Click"/>
                <Button x:Name="Btn_PlaySound2"
                        ToolTip="Play Sound UK (SHIFT+F8)"
                        Content="▷"
                        Margin="5,0"
                        FontSize="14"
                        Click="Btn_PlaySound2_Click"/>
                <Button x:Name="Btn_Next"
                        ToolTip="Next (SCROLL)"
                        Content="➔"
                        Margin="5,0"
                        FontSize="14"
                        Click="Btn_Next_Click"/>
                <Button x:Name="Btn_Delete"
                        ToolTip="Delete Word"
                        Content="🗑"
                        Margin="5,0,0,0"
                        FontSize="14"
                        Click="Btn_Delete_Click"/>
            </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
